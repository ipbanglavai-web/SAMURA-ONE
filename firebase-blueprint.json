{
  "entities": {
    "salesDueRecords": {
      "title": "Sales & Due Records",
      "description": "Sales, payments, running dues, and debtor ledgers created by managers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "invoiceNo": { "type": "string" },
        "date": { "type": "string" },
        "customerName": { "type": "string" },
        "address": { "type": "string" },
        "customerOf": { "type": "string" },
        "exDue": { "type": "number" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "productUnit": { "type": "string" },
        "unitPrice": { "type": "number" },
        "quantity": { "type": "number" },
        "amount": { "type": "number" },
        "paid": { "type": "number" },
        "sacrifice": { "type": "number" },
        "payableDue": { "type": "number" },
        "runningDue": { "type": "number" },
        "duePaymentDate": { "type": "string" },
