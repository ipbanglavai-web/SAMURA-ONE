        "createdAt": { "type": "string" }
      },
      "required": ["businessId", "name", "unit", "unitPrice"]
    },
    "managerCustomers": {
      "title": "Manager Customers",
      "description": "Customers directory and current due profiles for unit businesses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
