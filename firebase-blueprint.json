        "createdAt": { "type": "string" }
      },
      "required": ["businessId", "name", "phone", "address"]
    },
    "businessManagers": {
      "title": "Business Managers",
      "description": "Unit managers list for enterprise management",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "nid": { "type": "string" },
        "businessId": { "type": "string" },
        "businessName": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "businessId"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /{document=**} {\n      allow read, write: if true;\n    }\n  }\n}"
